# --- Telegram ---
# Token from @BotFather (never commit the real value)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id; only this id may use the bot
ALLOWED_TELEGRAM_USER_ID=

# --- Database ---
# PostgreSQL async DSN used by the running bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/beza

# --- Display / behaviour ---
CURRENCY=ETB
TIMEZONE=Africa/Addis_Ababa
# Allow selling above available stock (default False -> insufficient stock is an error)
ALLOW_NEGATIVE_STOCK=false

# --- Optional: AI-assisted natural language input (left empty by default) ---
# If you later plug in an LLM provider, set these; structured flows work without them.
# LLM_API_KEY=
# LLM_API_BASE=
# LLM_MODEL=
